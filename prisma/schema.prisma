generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id               String           @id // Maps to Supabase auth.users UUID
  email            String           @unique
  name             String?
  avatarUrl        String?
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  profile          Profile?
  resumes          Resume[]
}

enum OnboardingStatus {
  NOT_STARTED
  PROFILE
  PREFERENCES
  COMPLETED
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName         String?
  lastName          String?
  phone             String?
  currentTitle      String?
  yearsOfExperience Int?
  summary           String?
  country           String?
  city              String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Resume {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  status      ResumeStatus @default(UPLOADED)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}
