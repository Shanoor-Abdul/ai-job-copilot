generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id               String           @id // Maps to Supabase auth.users UUID
  email            String           @unique
  name             String?
  avatarUrl        String?
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  profile          Profile?
  resumes          Resume[]
}

enum OnboardingStatus {
  NOT_STARTED
  PROFILE
  PREFERENCES
  COMPLETED
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName         String?
  lastName          String?
  phone             String?
  currentTitle      String?
  yearsOfExperience Int?
  summary           String?
  country           String?
  city              String?
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  
  skills            String[] @default([])
  achievements      String[] @default([])
  projects          Project[]
  experiences       Experience[]
  educations        Education[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  company     String
  title       String
  startDate   String?
  endDate     String?
  description String?
  technologies String[] @default([])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    String?
  endDate      String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  startDate   String?
  endDate     String?
  url         String?
  technologies String[] @default([])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resume {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  status      ResumeStatus @default(UPLOADED)
  
  parsedData  ParsedResumeData?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ParsedResumeData {
  id               String   @id @default(cuid())
  resumeId         String   @unique
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  // Raw parsed JSON
  extractedData    Json
  
  processingTimeMs Int?
  confidenceScore  Float?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  PARSED
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}
