# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret: never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Protects the scheduled ingestion endpoint
JOB_SYNC_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated board identifiers you are authorized to index.
# Greenhouse board token (not company display name), e.g. companyname
GREENHOUSE_BOARD_TOKENS=
# Lever site names, e.g. companyname
LEVER_SITE_NAMES=

# Optional future AI integration
OPENAI_API_KEY=
